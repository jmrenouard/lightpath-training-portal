# LightPath Training Portal - Environment Configuration Example

# Storage driver ("json" flat-file default or "pdo" for PostgreSQL/SQLite)
LMS_STORAGE_DRIVER=json
LMS_DATA_DIR=./storage/data

# Optional PDO settings (used only when LMS_STORAGE_DRIVER=pdo)
LMS_PDO_DSN=pgsql:host=localhost;port=5432;dbname=lightpath_lms
LMS_PDO_USER=postgres
LMS_PDO_PASS=

# Course-pack paths (defaults to bundled examples/demo-course when unset)
LMS_COURSE_ROOT=
LMS_PGSCRIPTS_ROOT=

# Optional first-boot admin password (auto-generated if empty)
LMS_INIT_ADMIN_PASSWORD=

# Set to 1 to run lab UI/API in simulated mode without host Docker
LMS_DOCKER_FORCE_SIMULATED=1
